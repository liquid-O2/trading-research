      "expected":{"status":"excluded_cross_raw_contract_formation","never_report_width":109,"no_backadjusted_join":true,"prior_range_on_NQM4_to_current_NQU4":"raw_coordinate_comparison_unavailable_without_separately_defined_mapping"}
