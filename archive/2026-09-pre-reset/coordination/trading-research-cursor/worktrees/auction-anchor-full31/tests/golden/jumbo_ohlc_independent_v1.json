      "expected":{"status":"rejected_conflicting_duplicate_raw_interval","no_last_row_wins":true,"same_bytes_duplicate":"retain reconciliation identity or explicitly reject, never double-count","same_time_different_raw":"distinct cohorts, not merged"}
