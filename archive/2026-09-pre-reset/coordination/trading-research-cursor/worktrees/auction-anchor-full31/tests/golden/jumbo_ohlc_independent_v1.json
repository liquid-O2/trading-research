{
  "schema": "JumboOHLCIndependentCasesV1",
  "scope": "Independently specified literal source examples only; no candidate import, execution, data scan or test run. These examples do not certify a market cohort.",
  "conventions": {
    "prices": "Exact integer ticks; fractions use [numerator,denominator].",
    "relative_time": "Nonnegative nanoseconds from a date/contract-specific anchor T. One minute is60000000000ns.",
    "bar": "[start,end) with O/H/L/C for actual eligible observations; available_at=known_at>=end. Bar extrema have interval-censored event times. Close is final observed price, not proof of a trade exactly at end.",
    "formation": "[start,end), include only whole source bars; first/last required slots and complete declared coverage must be checked. No bar interpolation or OHLC-to-tick expansion.",
    "label": "Completed bars after frozen range availability, exact named endpoint; report envelope reach separately from exact traded touch. A same-bar order is unknown unless the open establishes an earlier boundary event.",
    "strict_break": "Upper price>H or lower price<L; inclusive envelope reach high>=H or low<=L. Reclaim means observed close strictly inside(L,H), known only at that close's publication.",
    "range_geometry": "W=H-L; wick25=L+.25W; body25=.75C+.25O; lower_body25=min(O,C)+.25abs(C-O); upper edge projection=H+kW, distinct from L+kW.",
    "calendar": "Use exact actual cash-calendar releases and timezone version. NY source-clock intervals and cash-session endpoints are separate definitions; no certified CME business-date inference."
  },
  "cases": [
    {
      "id": "JO01_half_open_and_delayed_final_publication",
      "input": {"formation": [0,120000000000], "bars": [
        {"start":0,"end":60000000000,"known_at":60000000000,"raw":"NQM4","ohlc":[100,104,98,102]},
        {"start":60000000000,"end":120000000000,"known_at":122000000000,"raw":"NQM4","ohlc":[102,110,101,108]},
        {"start":120000000000,"end":180000000000,"known_at":180000000000,"raw":"NQM4","ohlc":[108,999,1,500]}
      ], "cuts":[120000000000,122000000000]},
      "expected": {"at_first_cut":"final_range_unavailable_last_bar_not_known", "at_second_cut":{"ohlc":[100,110,98,108],"width":12,"available_at":122000000000},"included_bar_starts":[0,60000000000],"future_extreme_999_excluded":true,"no_backdated_final_at_formation_end":true}
    },
    {
      "id":"JO02_timestamp_unit_mismatch",
      "input":{"declared_unit":"ns","declared_duration_ns":60000000000,"bar_start":1717408800000,"bar_end":1717408860000,"candidate_millisecond_values_disguised_as_ns":true},
      "expected":{"status":"rejected_unit_or_duration_mismatch","observed_delta_in_declared_ns":60000,"never_auto_multiply_or_guess":true}
    },
    {
      "id":"JO03_missing_required_slot",
