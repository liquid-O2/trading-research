      "expected":{"after_first_bar":"upper_break_without_close_confirmed_reclaim","after_second_bar":"upper_break_then_close_confirmed_inside_reclaim","reclaim_confirmation_known_at":123000000000,"return_inside_event_interval":[60000000000,120000000000],"never_backdate_to_second_bar_open":true}
