      "expected":{"all_variants":"incomplete_not_final","missing_first":"open_unknown; observed_first_open_not_true_formation_open","missing_middle":"H/L/full_range_unavailable; observed_extrema_only_diagnostic","missing_last":"close_and_full_extrema_unavailable","no_fill_from_previous_close":true,"no_zero_fill_for_absence":true}
    },
    {
      "id":"JO04_duplicate_source_identity",
