      "expected":{"contact_by_first_close":"proved_by_observed_close100","first_contact_time":"interval_censored; earlier_touch_unresolved","after_contact_first_bar_favorable_bounds":[0,10],"after_contact_first_bar_adverse_bounds":[0,10],"full_horizon_favorable_bounds":[6,10],"full_horizon_adverse_bounds":[1,10],"terminal_from_contact":4,"using_contact_bar_high_and_low_as_exact_post_contact_excursions":"forbidden"}
