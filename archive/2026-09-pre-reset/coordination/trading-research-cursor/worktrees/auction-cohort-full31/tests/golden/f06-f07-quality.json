          {
            "id": "b",
            "observed_at": 20,
            "known_at": 20,
            "receipt_at": 20,
            "value": 100
          },
          {
            "id": "copy",
            "observed_at": 20,
            "known_at": 30,
            "receipt_at": 30,
            "value": 100,
            "content_origin_id": "b"
          }
        ],
        "healthy_liveness": {
          "id": "pulse35",
          "source_observed_at": 35,
          "known_at": 35
        },
        "dead_liveness": {
          "id": "pulse20",
          "source_observed_at": 20,
          "known_at": 20
        },
        "cut": 35,
        "max_economic_age_ns": 20,
        "max_source_silence_ns": 5
      },
      "expected": {
        "last_value_change_at": 10,
        "last_source_observation_at": 20,
        "last_local_receipt_at": 30,
        "economic_observed_at": 20,
        "age_ns": 15,
        "healthy": {
          "liveness_at": 35,
          "liveness_age_ns": 0,
          "state": "observed"
        },
        "dead": {
          "liveness_at": 20,
          "liveness_age_ns": 15,
          "state": "stale",
          "reason": "source_silent"
        },
        "content_origin_id": "b",
        "new_equal_observation_changes_lineage": true,
        "snapshot_copy_is_new_flow": false
      }
    },
