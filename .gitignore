# Bulk data stays on the volume and in R2, never in git.
/data/
**/.venv/
WORKSPACE_TREE.jsonl
archive/host-dupes-*/
/runs/**/*.npz
/runs/**/*.npy
/runs/**/*.f32
/runs/**/*.parquet

# Caches and scratch.
**/__pycache__/
*.py[cod]
*.tmp
*.log
.DS_Store
/.pytest_cache/
/.ruff_cache/
/.optmem/
/.unlazy/
/.unlazy-hook-state.json
/.s3compat_uploads/

# Secrets and vendor prompt dumps stay off GitHub. They still ride R2.
/.secrets/
.claude/settings.local.json
.codex/sol-system-prompt.md
.codex/sol-instructions.md
.opencode/node_modules/

# Local credentials are never committed.
.config/rclone/rclone.conf
.env
.env.*
!.env.example

# Generated data, credentials, and local execution artifacts.
/archive/
**/.env
**/.env.*
**/.secrets/
**/artifacts/
*.parquet
*.arrow
*.dbn
*.zst
*.sqlite
*.sqlite3
*.restore-tmp

# Large read-only market views are regenerated from their retained manifests.
/implementation/reports/phase1-live/derived-views/**/trades.jsonl
/implementation/reports/phase1-live/derived-views/**/bbo.jsonl

# Full method coverage/trace dumps remain on disk; publish summaries and hashes.
/implementation/reports/phase1-live/methods/*/
/implementation/reports/phase1-live/methods/*.json
!/implementation/reports/phase1-live/methods/command-results.json
!/implementation/reports/phase1-live/methods/pass-summary.json

# Small chart diagnostics and their frozen selections are reviewable outputs.
!/implementation/reports/phase1-live/methods/charts/
!/implementation/reports/phase1-live/methods/charts/**
!/implementation/reports/phase1-live/methods/reconstructions/
!/implementation/reports/phase1-live/methods/reconstructions/**

# Publish Phase 1 completion summaries; full coverage and trace runs stay local.
!/implementation/reports/phase1-live/methods/completion/
/implementation/reports/phase1-live/methods/completion/*
!/implementation/reports/phase1-live/methods/completion/*.md
/implementation/validation/phase1-completion/report-status-correction/previous/reports/
!/implementation/validation/phase1-completion/pytest.log
!/implementation/validation/phase1-completion/runner-logs/*-status-corrected.log
!/implementation/validation/phase1-completion/runner-logs/*-correctness-repaired.log
/implementation/validation/phase1-post-implementation-check/previous-acceptance/method-reports/

